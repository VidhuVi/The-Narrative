rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // A helper function to verify a user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Is the user trying to access a document they own based on the doc's authorId?
    function isOwner(documentData) {
      return documentData.authorId == request.auth.uid;
    }

    // Does the incoming payload enforce the caller's auth UID as the authorId?
    function enforcesOwnerInPayload() {
      return request.resource.data.authorId == request.auth.uid;
    }

    // -------------------------------------------------------------
    // Security Rules by Collection
    // -------------------------------------------------------------

    match /meetings/{meetingId} {
      // Any authenticated user can create a meeting if they stamp it with their own UID
      allow create: if isAuthenticated() && enforcesOwnerInPayload();
      
      // A user can only read, update, or delete a meeting if they are the verified author
      allow read, update, delete: if isAuthenticated() && isOwner(resource.data);
    }

    match /actionItems/{itemId} {
      allow create: if isAuthenticated() && enforcesOwnerInPayload();
      allow read, update, delete: if isAuthenticated() && isOwner(resource.data);
    }

    match /decisions/{decisionId} {
      allow create: if isAuthenticated() && enforcesOwnerInPayload();
      allow read, update, delete: if isAuthenticated() && isOwner(resource.data);
    }
  }
}
